--------------------------------------------------------------------------------
2. ANIMATION TIMELINE REGISTRY:
--------------------------------------------------------------------------------
A. [Anim_GearShift] (Duration: 0.18s):
   - Track: GearIndicatorBox.RenderScale (Key 0.0s: (1.25, 1.25) -> Key 0.18s: (1.0, 1.0))
   - Track: Txt_Gear.ColorAndOpacity (Key 0.0s: Pure Cyan/Glow -> Key 0.18s: White)

B. [Anim_RedlineWarningPulse] (Duration: 0.1s, Looping):
   - Track: RPMBarImage.RenderOpacity (Key 0.0s: 1.0 -> Key 0.05s: 0.4 -> Key 0.1s: 1.0)

C. [Anim_WarningFlash] (Duration: 0.5s, Looping):
   - Track: CenterWarningHUD.RenderOpacity (Key 0.0s: 0.0 -> Key 0.25s: 1.0 -> Key 0.5s: 0.0)

--------------------------------------------------------------------------------
3. SOUND BINDINGS:
--------------------------------------------------------------------------------
   - SFX_ShiftChime: SoundCue'/Game/Audio/UI/SC_UI_GearShift'
   - SFX_RedlineBeep: SoundCue'/Game/Audio/UI/SC_UI_RedlineAlarm'
   - SFX_WarningStrobe: SoundCue'/Game/Audio/UI/SC_UI_WarningAlert'
   - SFX_DRS_Deploy: SoundCue'/Game/Audio/Vehicles/SC_Aero_DRS_Deploy'
   - SFX_BoostEngage: SoundCue'/Game/Audio/Vehicles/SC_HybridBoostEngage'

--------------------------------------------------------------------------------
4. C++ METHOD CALLS & EVENT GRAPH:
--------------------------------------------------------------------------------

Variables:
   - ControlledCar: ABaseCar
   - HypercarRef: AHypercar
   - TrackSupercarRef: ATrackSupercar
   - VelocityPC: AVelocityPlayerController
   - GameModeRef: AVELOCITYXGameMode
   - DynMat_Speedometer: UMaterialInstanceDynamic
   - DynMat_RPM: UMaterialInstanceDynamic
   - DynMat_Minimap: UMaterialInstanceDynamic
   - PreviousGear: int = 1
   - MaxSpeedRef: float = 420.0f
   - MaxRPMRef: float = 9000.0f

Event Construct:
   1. VelocityPC = Cast<AVelocityPlayerController>(GetPlayerController(0))
   2. GameModeRef = Cast<AVELOCITYXGameMode>(GetWorld()->GetAuthGameMode())
   3. Create Dynamic Material Instances for Speedometer, RPM, and Minimap
   4. Resolve Controlled Car:
      - ControlledCar = VelocityPC->GetControlledCar() // or Cast<ABaseCar>(VelocityPC->GetPawn())
      - HypercarRef = Cast<AHypercar>(ControlledCar)
      - TrackSupercarRef = Cast<ATrackSupercar>(ControlledCar)
      - If (IsValid(HypercarRef)):
          HypercarBoostBox->SetVisibility(ESlateVisibility::Visible)
          TrackSupercarDRSBox->SetVisibility(ESlateVisibility::Collapsed)
      - Else If (IsValid(TrackSupercarRef)):
          HypercarBoostBox->SetVisibility(ESlateVisibility::Collapsed)
          TrackSupercarDRSBox->SetVisibility(ESlateVisibility::Visible)
      - Else:
          HypercarBoostBox->SetVisibility(ESlateVisibility::Collapsed)
          TrackSupercarDRSBox->SetVisibility(ESlateVisibility::Collapsed)
      - If (IsValid(ControlledCar)):
          Txt_ModelName->SetText(ControlledCar->GetPhysicsSettings().VehicleName)

Event Tick (DeltaTime):
   If (!IsValid(ControlledCar)):
      ControlledCar = VelocityPC ? VelocityPC->GetControlledCar() : nullptr;
      Return;

   // 1. Speed Telemetry (ABaseCar::GetSpeedKPH / GetSpeedMPH)
   SpeedKPH = ControlledCar->GetSpeedKPH();
   SpeedRatio = FMath::Clamp(SpeedKPH / MaxSpeedRef, 0.0f, 1.0f);
   DynMat_Speedometer->SetScalarParameterValue("CurrentSpeedRatio", SpeedRatio);
   Txt_DigitalSpeed->SetText(RoundToInt(SpeedKPH));

   // 2. RPM & Redline (ABaseCar::GetEngineRPM)
   RPM = ControlledCar->GetEngineRPM();
   RPMRatio = FMath::Clamp(RPM / MaxRPMRef, 0.0f, 1.0f);
   DynMat_RPM->SetScalarParameterValue("CurrentRPMRatio", RPMRatio);
   RedlineRPM = ControlledCar->GetPhysicsSettings().Engine.RedlineRPM;
   If (RPM >= RedlineRPM):
       DynMat_RPM->SetScalarParameterValue("IsRedlineActive", 1.0f);
       If (!IsAnimationPlaying(Anim_RedlineWarningPulse)):
           Play Animation (Anim_RedlineWarningPulse, NumLoops=0);
           Play Sound 2D (SFX_RedlineBeep);
   Else:
       DynMat_RPM->SetScalarParameterValue("IsRedlineActive", 0.0f);
       Stop Animation (Anim_RedlineWarningPulse);

   // 3. Gear (ABaseCar::GetCurrentGear)
   Gear = ControlledCar->GetCurrentGear();
   If (Gear != PreviousGear):
       Play Animation (Anim_GearShift);
       Play Sound 2D (SFX_ShiftChime);
       PreviousGear = Gear;
   Switch (Gear):
       Case -1: Txt_Gear->SetText("R");
       Case 0:  Txt_Gear->SetText("N");
       Default: Txt_Gear->SetText(FString::FromInt(Gear));

   // 4. Lap / Race Timer (AVELOCITYXGameMode::GetElapsedTime)
   If (IsValid(GameModeRef)):
       Elapsed = GameModeRef->GetElapsedTime();
       Format Time MM:SS.mmm -> Txt_RaceTimer->SetText;

   // 5. Special Abilities (Hypercar Boost / TrackSupercar DRS)
   If (IsValid(HypercarRef)):
       BoostCharge = HypercarRef->GetBoostChargePercent(); // 0.0 to 1.0
       bBoostActive = HypercarRef->IsHybridBoostActive();
       Bar_HybridBoost->SetPercent(BoostCharge);
       Txt_BoostStatus->SetText(bBoostActive ? "BOOST DEPLOYED" : (BoostCharge >= 1.0 ? "100% READY" : "CHARGING..."));
   Else If (IsValid(TrackSupercarRef)):
       bDRS = TrackSupercarRef->IsDRSActive();
       TrackSupercarDRSBox->SetVisibility(bDRS ? ESlateVisibility::Visible : ESlateVisibility::HitTestInvisible);
       Badge_DRS->SetBrushColor(bDRS ? NeonGreen : Gray);

   // 6. Camera & Headlights
   CamIdx = VelocityPC->GetCameraIndex();
   Txt_CameraName->SetText(CamIdx == 0 ? "CAM: CHASE" : (CamIdx == 1 ? "CAM: COCKPIT" : "CAM: HOOD"));
   bLights = ControlledCar->AreHeadlightsOn();
   Txt_Headlight->SetText(bLights ? "BEAM: ON" : "BEAM: OFF");
   Txt_Headlight->SetColorAndOpacity(bLights ? NeonGreen : Gray);

   // 7. Telemetry Pedal Bars
   Bar_Throttle->SetPercent(ControlledCar->GetTelemetry().ThrottleInput);
   Bar_Brake->SetPercent(ControlledCar->GetTelemetry().BrakeInput);
================================================================================
*/
