Function SetLightState(bool bTurnOn):
   SpotLight_LeftLane->SetVisibility(bTurnOn);
   SpotLight_RightLane->SetVisibility(bTurnOn);
   // Modulate emissive scalar on Fixture Material Dynamic Instance
   FixtureLeftMesh->SetScalarParameterValueOnMaterials("EmissionIntensityNits", bTurnOn ? 50000.0f : 0.0f);
   FixtureRightMesh->SetScalarParameterValueOnMaterials("EmissionIntensityNits", bTurnOn ? 50000.0f : 0.0f);
